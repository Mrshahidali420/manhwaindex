---
import Base from '../../layouts/Base.astro'
import Platforms from '../../components/Platforms.astro'
import CoverGrid from '../../components/CoverGrid.astro'
import {
  comics,
  anime,
  findAnime,
  findComic,
  formatWord,
  statusWord,
  truncate,
  charactersOf,
  inIndex,
  pathOf,
  platform,
  enrichOf,
  genreSlug,
} from '../../lib/catalog.js'

export function getStaticPaths() {
  const KIND_OF_COUNTRY = { KR: 'manhwa', JP: 'manga', CN: 'manhua', TW: 'manhua' }

  const comicPaths = comics.map((item) => ({
    params: { kind: KIND_OF_COUNTRY[item.country] || 'manga', slug: item.slug },
    props: { item, isComic: true },
  }))

  const animePaths = anime.map((item) => ({
    params: { kind: 'anime', slug: item.slug },
    props: { item, isComic: false },
  }))

  return [...comicPaths, ...animePaths]
}

const { item, isComic } = Astro.props

const word = isComic ? formatWord(item) : 'anime'
const links = isComic ? item.readLinks : item.watchLinks
const related = isComic ? item.animeInIndex : item.comicInIndex

// The page title is written the way people actually type the search.
const pageTitle = isComic
  ? `Read ${item.title} Online — Official ${word} Sites & Apps`
  : `Watch ${item.title} Online — Official Streaming Sites`

// Airing helper: turn the next-episode timestamp into a readable date.
const nextEp = item.nextEpisode
  ? new Date(item.nextEpisode.at * 1000).toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
    })
  : null

const platformNames = links.map((l) => l.site)
const description = links.length
  ? `${item.title} is officially ${isComic ? 'readable' : 'streaming'} on ${platformNames
      .slice(0, 3)
      .join(', ')}${platformNames.length > 3 ? ` and ${platformNames.length - 3} more` : ''}. ` +
    `${statusWord(item.status)}${item.chapters ? `, ${item.chapters} chapters` : ''}${
      item.episodes ? `, ${item.episodes} episodes` : ''
    }.`
  : `${item.title} has no official English ${isComic ? 'reading' : 'streaming'} platform listed yet. Here is what we know about it.`

const facts = [
  ['Status', statusWord(item.status)],
  isComic ? ['Chapters', item.chapters ?? 'Not counted'] : ['Episodes', item.episodes ?? 'Not counted'],
  isComic ? ['Volumes', item.volumes ?? '—'] : ['Studio', item.studios[0] ?? '—'],
  ['First released', item.startYear ?? '—'],
  ['Country', { KR: 'South Korea', JP: 'Japan', CN: 'China', TW: 'Taiwan' }[item.country] || '—'],
  ['Format', word],
  ...(item.authors?.length ? [['Author', item.authors.map((a) => a.name).join(', ')]] : []),
  ...(nextEp ? [[`Episode ${item.nextEpisode.number} airs`, nextEp]] : []),
  ...(item.favourites ? [['AniList favourites', item.favourites.toLocaleString()]] : []),
].filter(([, value]) => value !== '—' || true)

const jsonld = {
  '@context': 'https://schema.org',
  '@type': isComic ? 'Book' : 'TVSeries',
  name: item.title,
  alternateName: item.titleNative || item.titleRomaji,
  image: item.cover,
  description: truncate(item.description, 400),
  genre: item.genres,
  ...(isComic ? { bookFormat: 'https://schema.org/GraphicNovel' } : {}),
  ...(item.episodes ? { numberOfEpisodes: item.episodes } : {}),
  ...(item.authors?.length ? { author: item.authors.map((a) => ({ '@type': 'Person', name: a.name })) } : {}),
  ...(item.trailer
    ? {
        trailer: {
          '@type': 'VideoObject',
          name: `${item.title} trailer`,
          embedUrl: `https://www.youtube-nocookie.com/embed/${item.trailer.id}`,
          thumbnailUrl: item.trailer.thumb || undefined,
        },
      }
    : {}),
  ...(item.score
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: (item.score / 10).toFixed(1),
          bestRating: 10,
          ratingCount: Math.max(item.favourites, 1),
        },
      }
    : {}),
  ...(links.length
    ? {
        potentialAction: links.map((l) => ({
          '@type': isComic ? 'ReadAction' : 'WatchAction',
          target: l.url,
          name: l.site,
        })),
      }
    : {}),
}
const cast = charactersOf(item).slice(0, 12)

// You may also like: same shelf, closest genre mix, most-read first.
const pool = isComic ? comics.filter((p) => formatWord(p) === word) : anime
const myGenres = new Set(item.genres)
const similar = pool
  .filter((p) => p.id !== item.id)
  .map((p) => ({ p, hits: p.genres.reduce((n, g) => n + (myGenres.has(g) ? 1 : 0), 0) }))
  .filter((x) => x.hits >= 2)
  .sort((a, b) => b.hits - a.hits || b.p.popularity - a.p.popularity)
  .slice(0, 6)
  .map((x) => x.p)
const similarBase = isComic ? `/${word}` : '/anime'
const kindBase = similarBase
const kindLabel = word.charAt(0).toUpperCase() + word.slice(1)

// The family tree: prequels, sequels, side stories, spin-offs.
// Adaptations are left out — the anime/original sections above cover them.
const RELATION_LABEL = {
  PREQUEL: 'Prequel',
  PARENT: 'Main story',
  SEQUEL: 'Sequel',
  SIDE_STORY: 'Side story',
  SPIN_OFF: 'Spin-off',
  ALTERNATIVE: 'Alternative version',
}
const RELATION_ORDER = Object.keys(RELATION_LABEL)
const family = (item.relations || [])
  .filter((r) => RELATION_LABEL[r.relation])
  .map((r) => ({ ...r, hit: inIndex(r.id) }))
  .sort((a, b) => RELATION_ORDER.indexOf(a.relation) - RELATION_ORDER.indexOf(b.relation))

const FAMILY_WORDS = { TV: 'anime series', MOVIE: 'anime film', SPECIAL: 'anime special', OVA: 'OVA', ONA: 'ONA' }
const familyWord = (r) =>
  r.type === 'ANIME'
    ? FAMILY_WORDS[r.format] || 'anime'
    : { KR: 'manhwa', JP: 'manga', CN: 'manhua', TW: 'manhua' }[r.country] || 'comic'

// Which languages have an official release. English leads: it is the
// question most visitors are really asking. Anime links carry no
// language data, so this stays comic-only.
// Platforms with a free tier or free chapters — the answer most
// visitors actually came for, so it gets its own line up top.
// MAL score + cross-site links, when the enrichment pull has data for us.
const extra = enrichOf(item)
const malScore = extra.mal && extra.mal.score ? extra.mal : null
const alsoSites = item.kind === 'anime'
  ? extra.sites || []
  : malScore && malScore.url
    ? [{ name: 'MyAnimeList', url: malScore.url }]
    : []

const freeLinks = []
{
  const seen = new Set()
  for (const link of links) {
    if (seen.has(link.site)) continue
    if ((platform(link.site).note || '').toLowerCase().includes('free')) {
      seen.add(link.site)
      freeLinks.push(link)
    }
  }
}

const languages = isComic ? [...new Set(links.map((l) => l.language).filter(Boolean))] : []
const hasEnglish = languages.includes('English')
const otherLanguages = languages.filter((l) => l !== 'English')
---

<Base
  title={pageTitle}
  description={description}
  image={item.cover}
  jsonld={jsonld}
>
  <div class="shell title-page">
    <div class="cover-rail">
      <div class="cover-wrap">
        <img
          class="cover"
          src={item.cover}
          alt={`Cover of ${item.title}`}
          width="460"
          height="651"
          fetchpriority="high"
        />
      </div>
      {
        (item.score || malScore) && (
          <div class="scores">
            {item.score && (
              <p class="cover-rail__score">
                <b>{(item.score / 10).toFixed(1)}</b>
                <span>on AniList</span>
              </p>
            )}
            {malScore && (
              <p class="cover-rail__score cover-rail__score--alt">
                <b>{malScore.score.toFixed(1)}</b>
                <span>on MyAnimeList</span>
              </p>
            )}
          </div>
        )
      }
    </div>

    <header class="title-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <a href={kindBase}>{kindLabel}</a>
      </nav>
      <h1>{item.title}</h1>
      {item.titleNative && <p class="title-head__native">{item.titleNative}</p>}
      <ul class="title-head__meta">
        <li>{statusWord(item.status)}</li>
        {item.startYear && <li>{item.startYear}</li>}
        {isComic && item.chapters && <li>{item.chapters} chapters</li>}
        {!isComic && item.episodes && <li>{item.episodes} episodes</li>}
        {item.genres.slice(0, 4).map((genre) => (
          <li class="title-head__genre">
            <a href={`/genre/${genreSlug(genre)}`}>{genre}</a>
          </li>
        ))}
      </ul>
    </header>

    <div class="title-body">

      {
        freeLinks.length > 0 && (
          <p class="free-call">
            <b>{isComic ? 'Read it free on' : 'Watch it free on'}</b>
            {freeLinks.map((link) => (
              <a href={link.url} rel="noopener nofollow sponsored" target="_blank">
                {link.site}
              </a>
            ))}
          </p>
        )
      }

      <Platforms
        heading={isComic ? 'Read it on' : 'Watch it on'}
        links={links}
        count={`${links.length} official ${links.length === 1 ? 'place' : 'places'}`}
      >
        <Fragment slot="empty">
          <p>
            <strong>No official platform listed yet.</strong>
            {' '}
            {isComic
              ? `No publisher has licensed ${item.title} in a language we track. That usually changes once a series gets popular, so it is worth checking back.`
              : `${item.title} is not on a streaming platform we track. It may be region-locked or not licensed yet.`}
          </p>
        </Fragment>
      </Platforms>

      {
        isComic && languages.length > 0 && (
          <p class="langs">
            {hasEnglish && <b>✓ Official English release</b>}
            {otherLanguages.length > 0 && (
              <span>
                {hasEnglish ? 'Also officially in' : 'Officially in'} {otherLanguages.join(' · ')}
              </span>
            )}
          </p>
        )
      }

      <p class="track-line">
        <a href={item.anilistUrl} target="_blank" rel="noopener">
          Track your progress on AniList ↗
        </a>
        <span>free account · keeps your reading list in one place</span>
      </p>

      {
        alsoSites.length > 0 && (
          <p class="also-on">
            <span>Also listed on</span>
            {alsoSites.map((site) => (
              <a href={site.url} target="_blank" rel="noopener">
                {site.name}
              </a>
            ))}
          </p>
        )
      }

      {
        isComic && (
          <section class="answer">
            <div class="answer__head">
              <h2>Is there an anime?</h2>
            </div>
            {related.length > 0 ? (
              related.map((rel) => (
                <a class="crosslink" href={`/anime/${rel.slug}`}>
                  <div>
                    <span class="crosslink__lead">Yes. Watch the adaptation</span>
                    <span class="crosslink__title">{rel.title}</span>
                    <span class="crosslink__lead">
                      {rel.episodes ? `${rel.episodes} episodes` : 'Episode count not confirmed'}
                      {rel.watchCount ? ` · on ${rel.watchCount} platforms` : ''}
                    </span>
                  </div>
                </a>
              ))
            ) : item.hasAnime ? (
              <div class="empty">
                <p>
                  <strong>Yes, an adaptation exists</strong>, but it is not in our index yet.
                </p>
              </div>
            ) : (
              <div class="empty">
                <p>
                  <strong>Not yet.</strong> {item.title} has no anime adaptation announced. Most
                  series never get one, so the comic is the whole story for now.
                </p>
              </div>
            )}
          </section>
        )
      }

      {
        !isComic && related.length > 0 && (
          <section class="answer">
            <div class="answer__head">
              <h2>Read the original</h2>
            </div>
            {related.map((rel) => (
              <a class="crosslink" href={`/manhwa/${rel.slug}`}>
                <div>
                  <span class="crosslink__lead">The anime is based on this</span>
                  <span class="crosslink__title">{rel.title}</span>
                  <span class="crosslink__lead">
                    {rel.readCount ? `${rel.readCount} official reading options` : 'No official reader yet'}
                  </span>
                </div>
              </a>
            ))}
          </section>
        )
      }

      {
        family.length > 0 && (
          <section class="answer">
            <div class="answer__head">
              <h2>The same story, elsewhere</h2>
              <p>Every prequel, sequel, side story and spin-off AniList knows about.</p>
            </div>
            <ul class="family">
              {family.map((rel) => (
                <li>
                  {rel.hit ? (
                    <a href={pathOf(rel.hit.item, rel.hit.kind)}>
                      <b>{RELATION_LABEL[rel.relation]}</b>
                      <span class="family__title">{rel.title}</span>
                      <span class="family__kind">{familyWord(rel)} · in the index</span>
                    </a>
                  ) : (
                    <a
                      href={`https://anilist.co/${rel.type.toLowerCase()}/${rel.id}`}
                      target="_blank"
                      rel="noopener"
                    >
                      <b>{RELATION_LABEL[rel.relation]}</b>
                      <span class="family__title">{rel.title}</span>
                      <span class="family__kind">{familyWord(rel)} · on AniList ↗</span>
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        cast.length > 0 && (
          <section class="answer">
            <div class="answer__head">
              <h2>Who is in it</h2>
              <p>Tap a face to see every other story that character turns up in.</p>
            </div>
            <ul class="people">
              {cast.map((person) => (
                <li>
                  <a href={`/character/${person.slug}`}>
                    <img src={person.image} alt="" width="220" height="293" loading="lazy" />
                    <b>{person.name}</b>
                    <span>{person.role === 'MAIN' ? 'Main' : 'Supporting'}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        item.trailer && (
          <section class="answer">
            <div class="answer__head">
              <h2>Trailer</h2>
            </div>
            <div class="trailer" data-yt={item.trailer.id}>
              {item.trailer.thumb && <img src={item.trailer.thumb} alt="" loading="lazy" />}
              <button type="button">
                <span>
                  <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
                    <path
                      d="M3 2l9 5-9 5z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linejoin="round"
                    />
                  </svg>
                  Play trailer
                </span>
              </button>
            </div>
            <script>
              // The iframe loads only on click, so YouTube costs nothing
              // until someone actually wants the video.
              document.querySelectorAll('.trailer').forEach((box) => {
                box.querySelector('button').addEventListener('click', () => {
                  const id = box.dataset.yt
                  box.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1" title="Trailer" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`
                })
              })
            </script>
          </section>
        )
      }

      <section class="answer">
        <div class="answer__head">
          <h2>The facts</h2>
        </div>
        <dl class="facts">
          {facts.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </section>

      {
        item.description && (
          <section class="answer">
            <div class="answer__head">
              <h2>What it is about</h2>
            </div>
            <p class="synopsis">{item.description}</p>
          </section>
        )
      }

      {
        similar.length > 0 && (
          <section class="answer">
            <div class="answer__head">
              <h2>You may also like</h2>
              <p>Closest {word} by genre, most-read first.</p>
            </div>
            <CoverGrid items={similar} base={similarBase} />
          </section>
        )
      }
    </div>
  </div>
</Base>
