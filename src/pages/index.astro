---
import Base from '../layouts/Base.astro'
import CoverGrid from '../components/CoverGrid.astro'
import { animeByPopularity, comics, comicsOfCountry, anime, genres, platform, airingThisWeek } from '../lib/catalog.js'

const manhwa = comicsOfCountry('KR')
const manga = comicsOfCountry('JP')
const manhua = comicsOfCountry('CN')
const readable = comics.filter((c) => c.readLinks.length > 0).length
const watchable = anime.filter((a) => a.watchLinks.length > 0).length

// The nine most-read covers stand on the horizon line like a skyline.
const skyline = manhwa.slice(0, 9)

// The legend names the platforms whose colours appear most under the covers.
const legendNames = [
  'WEBTOON',
  'Tappytoon',
  'Tapas',
  'Lezhin',
  'Manta',
  'Crunchyroll',
  'Netflix',
  'Hulu',
]
const legend = legendNames.map((name) => ({ name, color: platform(name).color }))

// Airing schedule: episode day names are computed at build time (daily rebuild).
const airing = airingThisWeek.slice(0, 8).map((a) => ({
  ...a,
  airDay: new Date(a.nextEpisode.at * 1000).toLocaleDateString('en-US', { weekday: 'long' }),
}))

// One shelf per catalog, all visible at once. Arrows scroll each shelf.
const rows = [
  { id: 'manhwa', label: 'Trending manhwa', items: manhwa.slice(0, 18), base: '/manhwa', all: manhwa.length, note: 'The colour bars under each cover show which platforms carry it.' },
  { id: 'anime', label: 'Trending anime', items: animeByPopularity.slice(0, 18), base: '/anime', all: anime.length, note: 'Each one links back to the manga or manhwa it came from.' },
  { id: 'manga', label: 'Trending manga', items: manga.slice(0, 18), base: '/manga', all: manga.length, note: '' },
  { id: 'manhua', label: 'Trending manhua', items: manhua.slice(0, 18), base: '/manhua', all: manhua.length, note: '' },
]

// The hero stands in front of a real banner: the most popular manhwa
// that ships wide art. Masked so it dissolves into the cyc gradient.
const heroBanner = manhwa.find((m) => m.banner)?.banner

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'manhwaindex',
  url: 'https://manhwaindex.com',
  description:
    'Find the official place to read any manhwa, manga or manhua, and the official place to watch the anime.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://manhwaindex.com/manhwa?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
}
---

<Base
  title="manhwaindex — where to read manhwa and watch anime online, legally"
  description="Look up any manhwa, manga, manhua or anime and see the official apps that carry it. No pirate mirrors, just the publishers and streaming platforms that hold the rights."
  jsonld={jsonld}
>
  <section class="hero hero--home">
    {heroBanner && (
      <img class="hero__banner" src={heroBanner} alt="" width="1900" height="760" loading="eager" fetchpriority="high" decoding="async" />
    )}
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="shell hero__content">
      <h1>You found the series. Now find where it is.</h1>
      <p>
        Find where to read your favorite manhwa, manga and manhua — and where to watch
        the anime. Compare the official platforms, what each one costs, and whether
        there is an adaptation yet. All in one place.
      </p>
    </div>
    <div class="skyline" aria-hidden="true">
      {
        skyline.map((item, i) => (
          <img
            src={item.cover}
            alt=""
            width="230"
            height="345"
            loading={i < 5 ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={i === 4 ? 'high' : undefined}
          />
        ))
      }
    </div>
  </section>

  <div class="shell cue-sheet">
    <p>
      <b>{comics.length.toLocaleString()}+</b> titles indexed ·
      <b>{readable.toLocaleString()}+</b> with official reading links ·
      <b>{anime.length.toLocaleString()}+</b> anime ·
      <b>{watchable.toLocaleString()}+</b> with official streaming info
    </p>
  </div>

  <div class="shell">
    {
      rows.map((row) => (
        <section class="section" data-phase="night">
          <div class="section__head section__head--row">
            <div>
              <h2>{row.label}</h2>
              {row.note && <p>{row.note}</p>}
            </div>
            <a class="section__more" href={row.base}>
              All {row.all.toLocaleString()} →
            </a>
          </div>
          <div class="shelf-wrap">
            <button type="button" class="shelf-arrow shelf-arrow--left" aria-label={`Scroll ${row.id} left`}>
              ‹
            </button>
            <CoverGrid items={row.items} base={row.base} shelf />
            <button type="button" class="shelf-arrow shelf-arrow--right" aria-label={`Scroll ${row.id} right`}>
              ›
            </button>
          </div>
        </section>
      ))
    }
    <script>
      for (const wrap of document.querySelectorAll('.shelf-wrap')) {
        const shelf = wrap.querySelector('.grid--shelf')
        const arrows = [wrap.querySelector('.shelf-arrow--left'), wrap.querySelector('.shelf-arrow--right')]
        const stride = () => {
          const cards = shelf.querySelectorAll('.card')
          return cards.length > 1
            ? cards[1].offsetLeft - cards[0].offsetLeft
            : shelf.clientWidth * 0.8
        }
        const page = (dir) => {
          const step = stride()
          const cardsPerView = Math.max(1, Math.floor(shelf.clientWidth / step))
          shelf.scrollBy({ left: dir * cardsPerView * step, behavior: 'smooth' })
        }
        arrows[0].addEventListener('click', () => page(-1))
        arrows[1].addEventListener('click', () => page(1))
        const update = () => {
          arrows[0].disabled = shelf.scrollLeft < 4
          arrows[1].disabled = shelf.scrollLeft > shelf.scrollWidth - shelf.clientWidth - 4
        }
        shelf.addEventListener('scroll', update, { passive: true })
        update()
      }
    </script>

    {
      airing.length > 0 && (
        <section class="section" data-phase="night">
          <div class="section__head">
            <h2>New episodes this week</h2>
            <p>Fresh from the airing schedule. Every link goes to an official stream.</p>
          </div>
          <ul class="airing">
            {airing.map((a) => (
              <li>
                <a href={`/anime/${a.slug}`}>
                  <img src={a.cover} alt="" width="52" height="74" loading="lazy" decoding="async" />
                  <span>
                    <b>{a.title}</b>
                    <em>
                      Episode {a.nextEpisode.number} · {a.airDay}
                      {a.watchLinks.length ? ` · on ${a.watchLinks.length} platforms` : ''}
                    </em>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="section legend" data-phase="first" aria-label="Platform colour legend">
      <p class="legend__lead">Every colour is one official platform:</p>
      <ul class="legend__list">
        {
          legend.map((l) => (
            <li>
              <i style={`--mark:${l.color}`} aria-hidden="true" />
              {l.name}
            </li>
          ))
        }
        <li class="legend__note">…and more. Open a title to see its full list.</li>
      </ul>
    </section>

    <section class="section" data-phase="day">
      <div class="section__head">
        <h2>Browse by genre</h2>
      </div>
      <ul class="chips">
        {
          genres.slice(0, 18).map((g) => (
            <li>
              <a href={`/genre/${g.slug}`}>{g.name}</a>
            </li>
          ))
        }
        <li><a href="/genre">All genres →</a></li>
      </ul>
    </section>
  </div>
</Base>
