---
import Base from '../layouts/Base.astro'
import CoverGrid from '../components/CoverGrid.astro'
import { animeByPopularity, comics, comicsOfCountry, anime, genres } from '../lib/catalog.js'

const manhwa = comicsOfCountry('KR')
const manga = comicsOfCountry('JP')
const manhua = comicsOfCountry('CN')
const readable = comics.filter((c) => c.readLinks.length > 0).length
const watchable = anime.filter((a) => a.watchLinks.length > 0).length

// The nine most-read covers stand on the horizon line like a skyline.
const skyline = manhwa.slice(0, 9)

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'manhwaindex',
  url: 'https://manhwaindex.com',
  description:
    'Find the official place to read any manhwa, manga or manhua, and the official place to watch the anime.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://manhwaindex.com/manhwa?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
}
---

<Base
  title="manhwaindex — where to read manhwa and watch anime online, legally"
  description="Look up any manhwa, manga, manhua or anime and see the official apps that carry it. No pirate mirrors, just the publishers and streaming services that hold the rights."
  jsonld={jsonld}
>
  <section class="hero hero--home">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="shell hero__content">
      <h1>You found the series. Now find where it is.</h1>
      <p>
        Someone recommends a manhwa and never says where to read it. Look it up here and
        you get the official apps that carry it, what each one costs, and whether there is
        an anime yet.
      </p>
    </div>
    <div class="skyline" aria-hidden="true">
      {
        skyline.map((item, i) => (
          <img
            src={item.cover}
            alt=""
            width="230"
            height="345"
            loading={i < 5 ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={i === 4 ? 'high' : undefined}
          />
        ))
      }
    </div>
  </section>

  <div class="shell cue-sheet">
    <span class="cue">Cue 05 · House count</span>
    <p>
      <b>{comics.length.toLocaleString()}</b> comics indexed ·
      <b>{readable.toLocaleString()}</b> with an official place to read ·
      <b>{anime.length.toLocaleString()}</b> anime ·
      <b>{watchable.toLocaleString()}</b> with official streaming
    </p>
  </div>

  <div class="shell">
    <section class="section" data-phase="night">
      <span class="section__cue cue">Cue 10 · Night</span>
      <div class="section__head section__head--row">
        <div>
          <h2>Trending manhwa</h2>
          <p>The colour bars under each cover show which platforms carry it.</p>
        </div>
        <a class="section__more" href="/manhwa">All {manhwa.length.toLocaleString()} →</a>
      </div>
      <CoverGrid items={manhwa.slice(0, 18)} base="/manhwa" shelf />
    </section>

    <section class="section" data-phase="first">
      <span class="section__cue cue">Cue 20 · First light</span>
      <div class="section__head section__head--row">
        <div>
          <h2>Trending anime</h2>
          <p>Each one links back to the manga or manhwa it came from.</p>
        </div>
        <a class="section__more" href="/anime">All {anime.length.toLocaleString()} →</a>
      </div>
      <CoverGrid items={animeByPopularity.slice(0, 18)} base="/anime" shelf />
    </section>

    <section class="section" data-phase="dawn">
      <span class="section__cue cue cue--rose">Cue 30 · Dawn</span>
      <div class="section__head section__head--row">
        <div>
          <h2>Trending manga</h2>
        </div>
        <a class="section__more" href="/manga">All {manga.length.toLocaleString()} →</a>
      </div>
      <CoverGrid items={manga.slice(0, 18)} base="/manga" shelf />
    </section>

    <section class="section" data-phase="hold">
      <span class="section__cue cue cue--rose">Cue 40 · Hold</span>
      <div class="section__head section__head--row">
        <div>
          <h2>Trending manhua</h2>
        </div>
        <a class="section__more" href="/manhua">All {manhua.length.toLocaleString()} →</a>
      </div>
      <CoverGrid items={manhua.slice(0, 18)} base="/manhua" shelf />
    </section>

    <section class="section" data-phase="day">
      <span class="section__cue cue cue--rose">Cue 50 · Day</span>
      <div class="section__head">
        <h2>Browse by genre</h2>
      </div>
      <ul class="chips">
        {
          genres.slice(0, 18).map((g) => (
            <li>
              <a href={`/genre/${g.slug}`}>{g.name}</a>
            </li>
          ))
        }
        <li><a href="/genre">All genres →</a></li>
      </ul>
    </section>
  </div>
</Base>
