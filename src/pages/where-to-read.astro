---
export const prerender = true
import Base from '../layouts/Base.astro'
import { comics, anime, platform, hubSlugOf } from '../lib/catalog.js'
import Mark from '../components/Mark.astro'

// One row per platform we link to, with how many titles it carries here.
function tally(items, key) {
  const map = new Map()
  for (const item of items) {
    const seen = new Set()
    for (const link of item[key] || []) {
      if (seen.has(link.site)) continue
      seen.add(link.site)
      map.set(link.site, (map.get(link.site) || 0) + 1)
    }
  }
  return [...map.entries()]
    // A platform with its own hub page becomes a link. The rest stay plain
    // text, because a link to a page we do not build is a 404.
    .map(([name, count]) => ({ name, count, hub: hubSlugOf(name), ...platform(name) }))
    .sort((a, b) => b.count - a.count)
}

const readingAll = tally(comics, 'readLinks')
const streamingAll = tally(anime, 'watchLinks')
const MIN_TITLES = 5
const reading = readingAll.filter((p) => p.count >= MIN_TITLES)
const streaming = streamingAll.filter((p) => p.count >= MIN_TITLES)
const readingRest = readingAll.length - reading.length
const streamingRest = streamingAll.length - streaming.length

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Where to read manhwa, manga and manhua legally',
  url: 'https://manhwaindex.com/where-to-read',
  description:
    'Every official platform this index links to, with what it costs and how many titles it carries.',
}
---

<Base
  title="Where to Read Manhwa Legally | Official Platforms"
  description="The official reading apps and streaming platforms this index links to: WEBTOON, Tapas, Tappytoon, MANGA Plus, Crunchyroll, Netflix and more — with what each one costs."
  canonical="/where-to-read"
  jsonld={jsonld}
>
  <div class="shell">
    <section class="section">
      <div class="section__head">
        <h1>Where to read, without the guesswork</h1>
        <p>
          This index answers one question: where can you legally read or watch a series?
          Here is every official platform we link to, and what it costs to start.
        </p>
      </div>

      <ol class="how">
        <li>
          <b>Search a title</b>
          <span>Type any of the {(comics.length + anime.length).toLocaleString()} titles into the search box above.</span>
        </li>
        <li>
          <b>Open its page</b>
          <span>Every title page lists the platforms that officially carry it.</span>
        </li>
        <li>
          <b>Pick a platform</b>
          <span>Each link opens the rights holder — free tiers first when they exist. We host nothing.</span>
        </li>
      </ol>
    </section>

    <section class="section" data-phase="night">
      <div class="section__head">
        <h2>Reading platforms</h2>
        <p>Where the comics live. The count is how many titles in this index each one carries.</p>
      </div>
      <ul class="ledger">
        {
          reading.map((p) => (
            <li style={`--mark:${p.color}`}>
              <Mark site={p.name} />
              <b>{p.hub ? <a href={`/platform/${p.hub}`}>{p.name}</a> : p.name}</b>
              <span>{p.note || 'Official'}</span>
              <em>{p.count.toLocaleString()} titles</em>
            </li>
          ))
        }
      </ul>
      {readingRest > 0 && <p class="ledger__rest">…and {readingRest} smaller platforms with a handful of titles each.</p>}
    </section>

    <section class="section" data-phase="first">
      <div class="section__head">
        <h2>Streaming platforms</h2>
        <p>Where the anime adaptations stream.</p>
      </div>
      <ul class="ledger">
        {
          streaming.map((p) => (
            <li style={`--mark:${p.color}`}>
              <Mark site={p.name} />
              <b>{p.hub ? <a href={`/platform/${p.hub}`}>{p.name}</a> : p.name}</b>
              <span>{p.note || 'Official'}</span>
              <em>{p.count.toLocaleString()} anime</em>
            </li>
          ))
        }
      </ul>
      {streamingRest > 0 && <p class="ledger__rest">…and {streamingRest} smaller platforms.</p>}
    </section>

    <section class="section" data-phase="day">
      <div class="section__head">
        <h2>Start browsing</h2>
      </div>
      <ul class="chips">
        <li><a href="/manhwa">Manhwa →</a></li>
        <li><a href="/manga">Manga →</a></li>
        <li><a href="/manhua">Manhua →</a></li>
        <li><a href="/anime">Anime →</a></li>
      </ul>
    </section>
  </div>
</Base>
