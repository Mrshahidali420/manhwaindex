---
/**
 * Now. What is happening on the site in the last few minutes.
 *
 * This is the only page that reloads itself, and it only asks small questions
 * about the last five minutes, so the free allowance is never at risk.
 */
import Admin from '../layouts/Admin.astro'
import { envOf } from '../lib/runtime.js'
import {
  gate,
  ask,
  askOne,
  clock,
  countryName,
  humanize,
  num,
  sectionName,
  sourceName,
  words,
} from '../lib/admin.js'

export const prerender = false

const env = envOf(Astro)
const { db, secret, signedIn, wrongWord } = await gate(Astro, env)

const now = Date.now()
const today = new Date(now).toISOString().slice(0, 10)

let live = {}
let todayRow = {}
let looking = []
let clicks = []
let missing = []

if (signedIn) {
  const [a, b, c, d, e] = await Promise.all([
    askOne(
      db,
      `SELECT COUNT(DISTINCT CASE WHEN visitor <> '' THEN visitor END) AS people,
              SUM(kind = 'view') AS views,
              COUNT(DISTINCT CASE WHEN session <> '' THEN session END) AS visits
       FROM events WHERE ts > ?`,
      now - 300000
    ),
    askOne(
      db,
      `SELECT SUM(kind = 'view') AS views,
              COUNT(DISTINCT CASE WHEN kind = 'view' AND visitor <> '' THEN visitor END) AS people,
              SUM(kind IN ('buy','read','watch','other')) AS clicks
       FROM events WHERE day = ?`,
      today
    ),
    ask(
      db,
      `SELECT ts, path, label, page_type, country, device, step, referrer, campaign, prev
       FROM events WHERE kind = 'view' ORDER BY ts DESC LIMIT 20`
    ),
    ask(
      db,
      `SELECT ts, name, kind, path, label, page_type, platform, country, target
       FROM events WHERE kind NOT IN ('view','leave') ORDER BY ts DESC LIMIT 30`
    ),
    // Addresses people asked for that are not here. Grouped, because one bad
    // link on somebody else's site sends the same wrong address over and over,
    // and the count is what says whether it is worth fixing.
    ask(
      db,
      `SELECT path,
              COUNT(*) AS hits,
              MAX(ts) AS last,
              MAX(referrer) AS referrer,
              MAX(prev) AS prev
       FROM events WHERE kind = 'missing' AND ts > ?
       GROUP BY path ORDER BY hits DESC, last DESC LIMIT 25`,
      now - 604800000
    ),
  ])
  live = a
  todayRow = b
  looking = c
  clicks = d
  missing = e
}

/**
 * Where this one page view came from, in three words or less.
 * A tagged link wins, then another website, then one of our own pages, and
 * last of all a person who typed the address.
 */
function cameFrom(row) {
  if (row.campaign) return sourceName(`utm:${row.campaign}`)
  if (row.referrer) return sourceName(row.referrer)
  if (row.prev) return `from ${humanize(row.prev, '')}`
  return 'Typed the address'
}
---

<Admin
  title="Now"
  here="/my-admin"
  signedIn={signedIn}
  secret={secret}
  wrongWord={wrongWord}
  refresh={60}
  note="The last five minutes. This page reloads itself every 60 seconds."
>
  <div class="cards">
    <div class="card live">
      <div class="n">{num(live.people)}</div>
      <div class="t">people here right now</div>
    </div>
    <div class="card">
      <div class="n">{num(live.views)}</div>
      <div class="t">pages opened in 5 minutes</div>
    </div>
    <div class="card">
      <div class="n">{num(todayRow.people)}</div>
      <div class="t">people today</div>
    </div>
    <div class="card">
      <div class="n">{num(todayRow.views)}</div>
      <div class="t">page views today</div>
    </div>
    <div class="card">
      <div class="n">{num(todayRow.clicks)}</div>
      <div class="t">links clicked today</div>
    </div>
  </div>

  <div class="panel">
    <h2>What they are looking at</h2>
    <p class="say">The last 20 pages opened, newest first.</p>
    {looking.length === 0 && <p class="empty">Nothing yet.</p>}
    <div class="feed">
      {looking.map((row) => (
        <div class="row">
          <div class="when">{clock(row.ts).replace(' UTC', '')}</div>
          <div class="what">
            <a href={row.path}>{humanize(row.path, row.label)}</a>
            <div class="meta">
              <span class="tag">{sectionName(row.page_type)}</span>
              <span class="tag src">{cameFrom(row)}</span>
              <span class="tag">{countryName(row.country)}</span>
              <span class="tag">page {row.step || 1}</span>
              <span class="tag">{row.device}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="panel">
    <h2>The last 30 clicks out</h2>
    <p class="say">
      Every link that sends a reader away. That hand-off is the job of this
      site.
    </p>
    {clicks.length === 0 && <p class="empty">No clicks yet.</p>}
    <div class="feed">
      {clicks.map((row) => (
        <div class="row">
          <div class="when">{clock(row.ts).replace(' UTC', '')}</div>
          <div class="what">
            <a href={row.target} rel="noopener nofollow" target="_blank">
              {row.platform || row.label || words(row.name)}
            </a>
            <div class="meta">
              <span class={row.kind === 'buy' ? 'tag buy' : 'tag go'}>{row.kind}</span>
              <span class="tag">from {humanize(row.path, '')}</span>
              <span class="tag">{sectionName(row.page_type)}</span>
              {row.country && <span class="tag">{countryName(row.country)}</span>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="panel">
    <h2>Broken links people hit</h2>
    <p class="say">
      Addresses asked for in the last 7 days that are not on this site. "Sent
      from" says where the reader came from, and that is where the bad link is.
      Our own name there means the bad link is on one of our own pages.
    </p>
    {missing.length === 0 && <p class="empty">Nothing broken. Good.</p>}
    <div class="feed">
      {missing.map((row) => (
        <div class="row">
          <div class="when">{num(row.hits)}×</div>
          <div class="what">
            <a href={row.path} rel="nofollow">{row.path}</a>
            <div class="meta">
              <span class="tag">last {clock(row.last).replace(' UTC', '')}</span>
              <span class="tag src">
                {row.referrer
                  ? `sent from ${sourceName(row.referrer)}`
                  : row.prev
                    ? `sent from our own ${humanize(row.prev, '')}`
                    : 'typed or a bookmark'}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Admin>
