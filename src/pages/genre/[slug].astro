---
export const prerender = true
import Base from '../../layouts/Base.astro'
import CoverGrid from '../../components/CoverGrid.astro'
import { genres, ofGenre } from '../../lib/catalog.js'
import { listingJsonld } from '../../lib/listing-jsonld.js'

export function getStaticPaths() {
  return genres.map((g) => {
    const { comics, anime } = ofGenre(g.name)
    return { params: { slug: g.slug }, props: { genre: g, comics, anime } }
  })
}

const { genre, comics, anime } = Astro.props
const KIND_OF_COUNTRY = { KR: 'manhwa', JP: 'manga', CN: 'manhua', TW: 'manhua' }

// The grids link by kind, so split the comics up.
const buckets = { manhwa: [], manga: [], manhua: [] }
for (const c of comics) buckets[KIND_OF_COUNTRY[c.country] || 'manga'].push(c)

const jsonld = listingJsonld({
  name: `${genre.name} manhwa, manga and anime`,
  description: `Every ${genre.name.toLowerCase()} title in the index, with the official platforms that carry it.`,
  path: `/genre/${genre.slug}`,
  items: [...comics, ...anime].slice(0, 40),
  total: comics.length + anime.length,
})
---

<Base
  title={`${genre.name} manhwa, manga and anime — where to read and watch`}
  description={`The most-read ${genre.name.toLowerCase()} manhwa, manga, manhua and the most-watched ${genre.name.toLowerCase()} anime — each with official read and watch links.`}
  canonical={`/genre/${genre.slug}`}
  jsonld={jsonld}
  crumbs={[{ name: 'Genres', href: '/genre' }, { name: genre.name }]}
>
  <div class="shell">
    <section class="section">
      <div class="section__head">
        <h1>{genre.name}</h1>
        <p>
          {comics.length.toLocaleString()} comics and {anime.length.toLocaleString()} anime
          carry this genre. Sorted by readers.
        </p>
      </div>
    </section>

    {
      Object.entries(buckets)
        .filter(([, items]) => items.length > 0)
        .map(([kind, items], i) => (
          <section class="section">
            <div class="section__head">
              <h2>{genre.name} {kind}</h2>
            </div>
            <CoverGrid items={items.slice(0, 24)} base={`/${kind}`} eager={i === 0 ? 6 : 0} />
          </section>
        ))
    }

    {
      anime.length > 0 && (
        <section class="section">
          <div class="section__head">
            <h2>{genre.name} anime</h2>
          </div>
          <CoverGrid items={anime.slice(0, 24)} base="/anime" />
        </section>
      )
    }
  </div>
</Base>
