---
/**
 * One genre page, built for every genre in the catalog.
 *
 * This is where the genre wall sends a reader, and most of them arrive on a
 * phone, so the page has to answer "what is in here" before the first grid.
 * It carries a real lede, a jump row to each kind, a short piece of prose,
 * a genre-specific FAQ, and doors out to the sibling genres.
 *
 * The lists themselves stay short. The sitemap links every title directly,
 * so a genre page is a doorway, not a dump.
 */
export const prerender = true
import Base from '../../layouts/Base.astro'
import CoverGrid from '../../components/CoverGrid.astro'
import { genres, ofGenre } from '../../lib/catalog.js'
import { listingJsonld } from '../../lib/listing-jsonld.js'
import { sectionOf } from '../../lib/section.mjs'

export function getStaticPaths() {
  return genres.map((g, i) => {
    const { comics, anime, novels } = ofGenre(g.name)
    // Neighbours in the popularity order read as "people who liked this",
    // without us inventing any relationship the data does not hold.
    const siblings = genres
      .filter((other) => other.slug !== g.slug)
      .slice(Math.max(0, i - 6), Math.max(0, i - 6) + 12)
    return { params: { slug: g.slug }, props: { genre: g, comics, anime, novels, siblings } }
  })
}

const { genre, comics, anime, novels = [], siblings } = Astro.props
const LABEL = { manhwa: 'manhwa', manga: 'manga', manhua: 'manhua', novel: 'novels' }
const ORIGIN = { manhwa: 'Korean comics', manga: 'Japanese comics', manhua: 'Chinese comics', novel: 'Light and web novels' }

// The grids link by kind, so split the comics up.
const buckets = { manhwa: [], manga: [], manhua: [], novel: [] }
for (const c of comics) buckets[sectionOf(c)].push(c)
for (const n of novels) buckets.novel.push(n)

const sections = Object.entries(buckets)
  .filter(([, items]) => items.length > 0)
  .map(([kind, items]) => ({
    id: kind,
    kind,
    heading: `${genre.name} ${LABEL[kind]}`,
    short: LABEL[kind][0].toUpperCase() + LABEL[kind].slice(1),
    blurb: `${ORIGIN[kind]} tagged ${genre.name.toLowerCase()}, most-read first. Each one lists the official apps that carry it.`,
    base: `/${kind}`,
    items,
  }))

const lower = genre.name.toLowerCase()
const topComic = comics[0]
const topAnime = anime[0]
const total = comics.length + novels.length + anime.length

const faqs = [
  {
    q: `What are the best ${lower} manhwa and manga right now?`,
    a: `The lists on this page are ordered by how many people are reading them, so the first row is the safest place to start.${
      topComic ? ` Today the most-read ${lower} comic in this index is ${topComic.title}.` : ''
    } The order rebuilds every day, so it follows real readers rather than an opinion.`,
  },
  {
    q: `Where can I read ${lower} titles legally?`,
    a: 'Open any title on this page and you get the official platforms licensed to carry it, with the cost of each one: free and ad-supported, a free tier, paid chapters, a subscription, or print. manhwaindex hosts nothing and never links to unlicensed copies.',
  },
  {
    q: `Is there ${lower} anime as well?`,
    a:
      anime.length > 0
        ? `Yes. ${anime.length.toLocaleString()} anime carry this genre.${
            topAnime ? ` ${topAnime.title} is the most-watched one here.` : ''
          } The anime section on this page links each one to the streaming services that hold it.`
        : 'Not in this index yet. No anime currently carries this genre, so the page lists comics only. It will appear here the morning after one is added.',
  },
  {
    q: 'What is the difference between manhwa, manga and manhua?',
    a: 'Manhwa is Korean, manga is Japanese and manhua is Chinese. This page keeps them in separate sections so you can stay in the one you prefer.',
  },
  {
    q: 'How often does this list change?',
    a: 'Every day. The catalog rebuilds at 02:00 UTC from AniList, so a series that started this week appears in its genre the next morning, and the reader counts move with it.',
  },
]

const site = 'https://manhwaindex.com'
const description = `The most-read ${lower} manhwa, manga, manhua and the most-watched ${lower} anime — each with official read and watch links.`

const collection = listingJsonld({
  name: `${genre.name} manhwa, manga and anime`,
  description,
  path: `/genre/${genre.slug}`,
  items: [...comics, ...anime].slice(0, 40),
  total,
})
delete collection['@context']

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    collection,
    {
      '@type': 'FAQPage',
      '@id': `${site}/genre/${genre.slug}#faq`,
      mainEntity: faqs.map((row) => ({
        '@type': 'Question',
        name: row.q,
        acceptedAnswer: { '@type': 'Answer', text: row.a },
      })),
    },
  ],
}
---

<Base
  title={`${genre.name} manhwa, manga and anime — where to read and watch`}
  description={description}
  canonical={`/genre/${genre.slug}`}
  jsonld={jsonld}
  crumbs={[{ name: 'Genres', href: '/genre' }, { name: genre.name }]}
>
  <div class="shell">
    <section class="section">
      <div class="section__head">
        <h1>{genre.name}</h1>
        <p>
          {comics.length.toLocaleString()} comics and {anime.length.toLocaleString()} anime
          carry the {lower} genre. Every list here is sorted by how many people are
          reading or watching, and every title opens on the official apps that carry it.
        </p>
      </div>

      <nav class="genre-quick" aria-label="Jump to a section">
        {sections.map((s) => <a href={`#${s.id}`}>{s.short}</a>)}
        {anime.length > 0 && <a href="#anime">Anime</a>}
        <a href="#about">About</a>
      </nav>
    </section>

    {
      sections.map((s, i) => (
        <section class="section" id={s.id}>
          <div class="section__head">
            <h2>{s.heading}</h2>
            <p>{s.blurb}</p>
          </div>
          <CoverGrid items={s.items.slice(0, 24)} base={s.base} eager={i === 0 ? 6 : 0} />
          {s.items.length > 24 && (
            <p class="shop-shelf__more">
              <a href={s.base}>See every {LABEL[s.kind]} in the index →</a>
            </p>
          )}
        </section>
      ))
    }

    {
      anime.length > 0 && (
        <section class="section" id="anime">
          <div class="section__head">
            <h2>{genre.name} anime</h2>
            <p>
              Series tagged {lower}, most-watched first. Each one links to the
              streaming services licensed to carry it, and to the comic it came from.
            </p>
          </div>
          <CoverGrid items={anime.slice(0, 24)} base="/anime" />
          {anime.length > 24 && (
            <p class="shop-shelf__more">
              <a href="/anime">See every anime in the index →</a>
            </p>
          )}
        </section>
      )
    }

    <section class="section" id="about">
      <div class="section__head">
        <h2>About {lower} on manhwaindex</h2>
      </div>
      <div class="genre-intro">
        <p>
          This page holds every title in the index that carries the {lower} tag:
          {' '}{total.toLocaleString()} in total. They are split into manhwa, manga,
          manhua and anime, so you can stay with Korean, Japanese or Chinese work
          if you already know which one you prefer.
        </p>
        <p>
          Open any cover and the page tells you where that series is licensed,
          and what each place costs: free and ad-supported, a free tier, paid
          chapters, a subscription, or print. manhwaindex hosts no chapters and
          no video, and never links to unlicensed copies.
        </p>
        <p>
          Genres come from AniList, the open catalog this index is built on.
          Nothing is typed in by hand, and the whole list rebuilds every day at
          02:00 UTC, so the order you see follows real readers.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Common questions</h2>
      </div>
      <div class="qa2">
        {
          faqs.map((row) => (
            <details>
              <summary>{row.q}</summary>
              <p class="qa2__a">{row.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Nearby genres</h2>
        <p>Genres of about the same size, for when this one is not quite it.</p>
      </div>
      <nav class="genre-quick" aria-label="Nearby genres">
        {siblings.map((g) => <a href={`/genre/${g.slug}`}>{g.name}</a>)}
      </nav>
    </section>

    <nav class="genre-next" aria-label="Keep browsing">
      <a href="/genre">All genres →</a>
      <a href="/where-to-read">Where to read →</a>
      <a href="/where-to-watch">Where to watch →</a>
      <a href="/shop">Shop merchandise →</a>
    </nav>
  </div>
</Base>
