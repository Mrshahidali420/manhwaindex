---
/**
 * The not-found page.
 *
 * Real people land here from an old bookmark and, more often than we would
 * like, straight from a search result. A dead end plus two browse links wastes
 * that visit. So this page now reads the address the visitor asked for, turns
 * the slug back into words, and offers that word straight to the site search.
 *
 * Addresses that really do have a home somewhere else are handled before this
 * page is ever reached: data/manual-redirects.json is merged into the redirect
 * map at build time and the worker sends a 301.
 */
export const prerender = true
import Base from '../layouts/Base.astro'
---

<Base
  title="Not found — manhwaindex"
  description="That page is not in the index."
  noindex={true}
  missing={true}
>
  <div class="shell">
    <section class="hero">
      <h1>That one is not in the index.</h1>
      <p id="miss-lede">
        Either the title has not been added yet, or the link is old. Start from a browse
        page and work down — the lists are ordered by how many people are reading.
      </p>
      <p id="miss-try" hidden>
        <button type="button" class="miss-search" id="miss-search">
          Search this index for <b id="miss-name"></b>
        </button>
      </p>
    </section>

    <nav class="genre-next" aria-label="Keep browsing">
      <a href="/manhwa">Browse manhwa →</a>
      <a href="/manga">Browse manga →</a>
      <a href="/manhua">Browse manhua →</a>
      <a href="/anime">Browse anime →</a>
      <a href="/genre">Browse by genre →</a>
      <a href="/character">Browse characters →</a>
    </nav>
  </div>

  <script is:inline>
    // Turn "/manga/uchi-de-kuzu-otoko-wa-kaemasen" into "uchi de kuzu otoko wa
    // kaemasen", then hand that to the search box the header already carries.
    ;(function () {
      var raw = ''
      try {
        raw = decodeURIComponent(location.pathname)
      } catch (e) {
        raw = location.pathname
      }
      var last = raw.split('/').filter(Boolean).pop() || ''
      // Old addresses carried the source id on the end. Drop it.
      var words = last
        .replace(/-\d{3,}$/, '')
        .replace(/[-_]+/g, ' ')
        .replace(/[^a-z0-9 ']/gi, ' ')
        .trim()
      if (words.length < 3) return

      var box = document.getElementById('miss-try')
      var name = document.getElementById('miss-name')
      var btn = document.getElementById('miss-search')
      var input = document.getElementById('finder-input')
      if (!box || !name || !btn || !input) return

      name.textContent = words
      box.hidden = false

      btn.addEventListener('click', function () {
        // On a phone the search box lives inside the closed menu panel.
        if (getComputedStyle(input).display === 'none' || input.offsetParent === null) {
          var menuBtn = document.querySelector('.menu-btn')
          if (menuBtn) menuBtn.click()
        }
        input.value = words
        input.dispatchEvent(new Event('input', { bubbles: true }))
        input.focus()
        window.scrollTo({ top: 0, behavior: 'smooth' })
      })
    })()
  </script>
</Base>
