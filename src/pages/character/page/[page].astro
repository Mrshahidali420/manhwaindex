---
export const prerender = true
import Base from '../../../layouts/Base.astro'
import { kindOfAppearance } from '../../../lib/catalog.js'
import { PEOPLE, PER_PAGE, MAX_PAGES } from '../index.astro'

export function getStaticPaths() {
  const pageCount = Math.min(MAX_PAGES, Math.ceil(PEOPLE.length / PER_PAGE))
  const paths = []
  for (let page = 2; page <= pageCount; page++) {
    paths.push({
      params: { page: String(page) },
      props: { pageCount, items: PEOPLE.slice((page - 1) * PER_PAGE, page * PER_PAGE) },
    })
  }
  return paths
}

const { page } = Astro.params
const { pageCount, items } = Astro.props
const current = Number(page)
---

<Base
  title={`Characters — page ${current} of ${pageCount}`}
  description="Look up a character by name and jump to the manhwa, manga or anime they are in."
  canonical={`/character/page/${current}`}
>
  <div class="shell">
    <section class="section">
      <div class="section__head">
        <h1>Characters</h1>
        <p>You remember the name, not the title. Start here.</p>
      </div>
      <ul class="people people--wall">
        {items.map((person) => (
          <li>
            <a href={`/character/${person.slug}`}>
              <img src={person.image} alt={`${person.name} portrait`} width="220" height="293" loading="lazy" decoding="async" />
              <b>{person.name}</b>
              <span>{kindOfAppearance(person.appearsIn[0])}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <nav class="pager" aria-label="Pagination">
      <a href={current === 2 ? '/character' : `/character/page/${current - 1}`} rel="prev">Previous</a>
      <span>Page {current} of {pageCount}</span>
      {current < pageCount ? <a href={`/character/page/${current + 1}`} rel="next">Next</a> : <span />}
    </nav>
  </div>
</Base>
