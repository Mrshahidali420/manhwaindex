---
/**
 * "Where to buy X merch."
 *
 * A character is what a figure is actually made of, so this is the page that
 * answers a merch search honestly. Only characters from a story big enough to
 * have merch made of it get one: see FIGURE_POPULARITY in shop-links.js.
 */
import Base from '../../../layouts/Base.astro'
import BuyBox from '../../../components/BuyBox.astro'
import { loadCharacter, loadTitle, envOf, countryOf, notFound, unavailable } from '../../../lib/runtime.js'
import { faqJsonld } from '../../../lib/answers.mjs'
import { kindOfAppearance } from '../../../lib/format.js'
import { characterShopLinks, FIGURE_POPULARITY } from '../../../lib/shop-links.js'
import { characterBuyAnswer } from '../../../lib/buy.mjs'
import { displayName } from '../../../lib/names.mjs'
import { hasCharacterBuyPage, hasBuyPage } from '../../../lib/gates.mjs'

let person
try {
  person = await loadCharacter(envOf(Astro), Astro.params.slug)
} catch (e) {
  // The shard did not read: 503, not 404. The page still exists.
  return unavailable(Astro, e)
}
if (!person || !person.image || !person.appearsIn?.length) return notFound(Astro)

// The same lead the profile page picks: a comic wins over its own anime.
const best = (rows) => rows.find((a) => a.kind !== 'anime') || rows[0]
const main = person.appearsIn.filter((a) => a.role === 'MAIN')
const lead = best(main.length ? main : person.appearsIn)
const leadKind = kindOfAppearance(lead)

// The gate. Under this line no figure of this person was ever made, so the
// page would be a shelf with nothing on it.
if ((lead.popularity || 0) < FIGURE_POPULARITY) return notFound(Astro)
// The sitemap's own gate, so the two can never disagree about this page.
if (!hasCharacterBuyPage(person)) return notFound(Astro)

let series
try {
  series = await loadTitle(envOf(Astro), leadKind, lead.slug)
} catch (e) {
  // The shard did not read: 503, not 404. The page still exists.
  return unavailable(Astro, e)
}
const buys = characterShopLinks(person, series || lead, countryOf(Astro))
if (buys.length === 0) return notFound(Astro)
const merchIsCharacter = buys.some((row) => row.kind === 'figures')

// The fan spelling leads here too, the same as on the profile page. The buy
// text is written from `person.name` and treats `aliases` as the other names,
// so it is handed a copy with the lead name swapped in and the AniList name
// first among the others. The shop rows above still search the record as it is.
// When nothing is swapped, the record goes in untouched.
const { primary, formal } = displayName(person)
const named = formal ? { ...person, name: primary, aliases: [formal, ...(person.aliases || [])] } : person
const answer = characterBuyAnswer(named, lead, series, leadKind, merchIsCharacter)
const profile = `/character/${person.slug}`
const seriesHome = `/${leadKind}/${lead.slug}`

const siblings = (series?.characters || [])
  .filter((c) => c.image && c.slug !== person.slug)
  .slice(0, 11)

const facts = [
  ['From', lead.title],
  ['Role', lead.role === 'MAIN' ? 'Main character' : 'Supporting character'],
  ...(person.age ? [['Age', person.age]] : []),
  ...(person.gender ? [['Gender', person.gender]] : []),
  ...(series?.startYear ? [['Story started', String(series.startYear)]] : []),
  [
    'Appears in',
    `${person.appearsIn.length} ${person.appearsIn.length === 1 ? 'title' : 'titles'}`,
  ],
  ...(person.favourites ? [['AniList favourites', person.favourites.toLocaleString()]] : []),
]

const jsonld = [
  {
    '@type': 'WebPage',
    '@id': `https://manhwaindex.com${profile}/buy#page`,
    url: `https://manhwaindex.com${profile}/buy`,
    name: answer.heading,
    inLanguage: 'en',
    dateModified: new Date().toISOString().slice(0, 10),
    about: { '@id': `https://manhwaindex.com${profile}#person` },
    alternateName: [person.native, ...answer.names].filter(Boolean),
  },
  faqJsonld(answer.faq),
]
---

<Base
  title={answer.pageTitle}
  description={answer.description}
  image={person.image}
  jsonld={jsonld}
  crumbs={[
    { name: 'Characters', href: '/character' },
    { name: primary, href: profile },
    { name: 'Merch' },
  ]}
>
  <div class="shell title-page">
    <div class="cover-rail">
      <div class="cover-wrap">
        <img class="cover" src={person.image} alt={`${primary} portrait`} width="440" height="587" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>

    <header class="title-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <a href="/character">Characters</a>
        <a href={profile}>{primary}</a>
      </nav>
      <h1>{answer.heading}</h1>
      {person.native && <p class="title-head__native">{person.native}</p>}
      {answer.names.length > 0 && (
        <p class="title-head__aka">Also written as {answer.names.join(' · ')}</p>
      )}
      <ul class="title-head__meta">
        <li>{lead.role === 'MAIN' ? 'Main character' : 'Supporting character'}</li>
        <li><a href={seriesHome}>{lead.title}</a></li>
        {series?.startYear && <li>{series.startYear}</li>}
      </ul>
    </header>

    <div class="title-body">
      <p class="title-answer">{answer.lede}</p>

      {/* The reader came here to buy. The shelves go first. */}
      <BuyBox
        heading={merchIsCharacter ? `Own a piece of ${primary}` : `Own ${lead.title}`}
        sub="Amazon, in your own country's store."
        rows={buys}
      />

      {
        answer.paragraphs.map((block) => (
          <section class="answer">
            <div class="answer__head">
              <h2>{block.heading}</h2>
            </div>
            <p class="overview">{block.text}</p>
          </section>
        ))
      }

      <section class="answer">
        <div class="answer__head">
          <h2>The facts</h2>
        </div>
        <dl class="facts">
          {
            facts.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      {
        siblings.length > 0 && (
          <section class="answer">
            <div class="answer__head">
              <h2>The rest of the cast</h2>
              <p>Tap a face to see that character, and the merch made of them.</p>
            </div>
            <ul class="people">
              {siblings.map((mate) => (
                <li>
                  <a href={`/character/${mate.slug}`}>
                    <img src={mate.image} alt={`${mate.name} portrait`} width="220" height="293" loading="lazy" decoding="async" />
                    <b>{mate.name}</b>
                    <span>{mate.role === 'MAIN' ? 'Main' : 'Supporting'}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="answer">
        <div class="answer__head">
          <h2>Common questions</h2>
        </div>
        <dl class="qa">
          {
            answer.faq.map((row) => (
              <div>
                <dt>{row.q}</dt>
                <dd>{row.a}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      {
        /* Only when the story's own buy page exists, or this is a door to a 404. */
        series && hasBuyPage(series) && (
          <a class="crosslink" href={`${seriesHome}/buy`}>
            <div>
              <span class="crosslink__lead">The story itself</span>
              <span class="crosslink__title">Where to buy {lead.title}</span>
              <span class="crosslink__lead">Printed volumes, discs, art books and posters</span>
            </div>
          </a>
        )
      }

      <a class="crosslink" href={profile}>
        <div>
          <span class="crosslink__lead">Everything we know about them</span>
          <span class="crosslink__title">{primary}</span>
          <span class="crosslink__lead">
            Every title they appear in, and where to read or watch it legally
          </span>
        </div>
      </a>
    </div>
  </div>
</Base>
