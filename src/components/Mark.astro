---
/**
 * One platform tile. The same square everywhere on the site.
 *
 * It carries the brand colour, and inside it either the real brand mark or
 * two letters. A reader learns the colour once and then finds the platform by
 * eye, without reading. `size` is a CSS length, so a row can ask for a small
 * tile and a page header can ask for a big one.
 */
import { markOf } from '../lib/format.js'

const { site, size = '2.1rem', class: extra = '' } = Astro.props
const mark = markOf(site)
---

<span
  class={`mark ${mark.path ? 'mark--logo' : 'mark--letters'} ${extra}`.trim()}
  style={`--mark:${mark.color}; --mark-size:${size}`}
  aria-hidden="true"
>
  {
    mark.path ? (
      <svg viewBox="0 0 24 24" role="presentation" focusable="false">
        <path d={mark.path} />
      </svg>
    ) : (
      <b>{mark.initials}</b>
    )
  }
</span>
