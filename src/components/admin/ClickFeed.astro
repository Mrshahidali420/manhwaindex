---
/**
 * The newest clicks out, one line each: a dot for the kind (read, watch,
 * buy), the time, the platform's logo, then "Platform · Title" cut with "…",
 * and a small line with the section and the country.
 *
 * The same link tapped twice in the same minute from the same page is one
 * line with "×2" (groupRepeats in src/lib/admin-chart.js).
 */
import PlatformIcon from './PlatformIcon.astro'
import { clock, countryName, humanize, sectionName, words } from '../../lib/admin.js'
import { clickKey, flagOf, groupRepeats } from '../../lib/admin-chart.js'

const { rows = [], empty = 'No clicks yet.' } = Astro.props
const TONE = { read: 'blue', watch: 'violet', buy: 'amber' }
const WORD = { read: 'Read', watch: 'Watch', buy: 'Buy', other: 'Other link' }
const lines = groupRepeats(rows, clickKey).map((row) => ({
  ...row,
  who: row.platform || row.label || words(row.name),
  from: humanize(row.path, ''),
  flag: flagOf(row.country),
  where: row.country ? countryName(row.country) : '',
}))
---

{lines.length === 0 && <p class="empty">{empty}</p>}
{lines.length > 0 && (
  <>
    <div class="kinds" aria-hidden="true">
      <span><i class="bg-blue"></i>read</span>
      <span><i class="bg-violet"></i>watch</span>
      <span><i class="bg-amber"></i>buy on Amazon</span>
      <span>×2 = same link twice in a minute</span>
    </div>
    <ul class="feed">
      {lines.map((row) => (
        <li>
          <span class={`dot bg-${TONE[row.kind] || 'dim'}`} title={WORD[row.kind] || row.kind}></span>
          <time datetime={new Date(row.ts).toISOString()}>{clock(row.ts).replace(' UTC', '')}</time>
          <PlatformIcon name={row.who} />
          <span class="what">
            <span class="line1" title={`${row.who} · ${row.from}`}>
              <span class="sr-only">{WORD[row.kind] || row.kind}: </span>
              {row.target ? (
                <a href={row.target} rel="noopener nofollow" target="_blank">{row.who}</a>
              ) : (
                <strong>{row.who}</strong>
              )}
              {' · '}{row.from}
            </span>
            <span class="meta">
              {sectionName(row.page_type)}
              {row.where && ` · ${row.flag ? `${row.flag} ` : ''}${row.where}`}
            </span>
          </span>
          {row.count > 1 ? (
            <span class="count" title={`${row.count} clicks in the same minute`}>×{row.count}</span>
          ) : (
            <span></span>
          )}
        </li>
      ))}
    </ul>
  </>
)}
