---
import '../styles/app.css'
// The shell shows only three numbers and eight genre names, so it reads a
// tiny file instead of the catalog. That keeps the Worker bundle small.
import stats from '../../data/site-stats.json'

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image,
  jsonld,
  crumbs = [],
  preloadImage,
  noindex = false,
} = Astro.props

const site = 'https://manhwaindex.com'
// build.format 'file' leaves '.html' on Astro.url.pathname; public URLs never carry it.
const cleanPath = canonical.replace(/\.html$/, '').replace(/^\/index$/, '/') || '/'
const canonicalUrl = new URL(cleanPath, site).href
const nav = [
  { href: '/manhwa', label: 'Manhwa' },
  { href: '/manga', label: 'Manga' },
  { href: '/manhua', label: 'Manhua' },
  { href: '/anime', label: 'Anime' },
  { href: '/schedule', label: 'Schedule' },
  { href: '/mood', label: 'Moods' },
  { href: '/where-to-read', label: 'Where to Read' },
  { href: '/genre', label: 'Genres' },
  { href: '/character', label: 'Characters' },
]
const here = Astro.url.pathname
const footGenres = stats.genres
const year = new Date().getUTCFullYear()

// One brand entity, on every page, so each page is a self-contained
// answer for a search engine that only ever reads this one URL.
const organization = {
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'manhwaindex',
  url: site,
  logo: `${site}/logo.svg`,
  description:
    'An index of manhwa, manga, manhua and anime that lists only the official platforms licensed to carry each title.',
  email: 'hello@manhwaindex.com',
}

// Breadcrumbs. Home is always the first step, so pages pass only the
// steps after it. The last step is the page itself and carries no link.
const breadcrumbs =
  crumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((step, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: step.name,
          ...(step.href ? { item: new URL(step.href, site).href } : {}),
        })),
      }
    : null

// Everything the page declares travels in one @graph, so the parts can
// reference each other by @id.
const nodes = [
  organization,
  ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : []).map(({ '@context': _c, ...node }) => ({
    ...node,
    isPartOf: { '@id': `${site}/#website` },
  })),
  {
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    url: site,
    name: 'manhwaindex',
    publisher: { '@id': organization['@id'] },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${site}/manhwa?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  ...(breadcrumbs ? [breadcrumbs] : []),
]
const graph = nodes.length > 0 ? { '@context': 'https://schema.org', '@graph': nodes } : null
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#050508" />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="manhwaindex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image || `${site}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Saira:wght@400;600;700;800&family=Saira+Stencil+One&display=swap"
    />
    <link rel="preconnect" href="https://s4.anilist.co" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    {graph && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}

    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Google Analytics 4. Declared in /privacy. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-R1V6DJN1L3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() { dataLayer.push(arguments) }
      gtag('js', new Date())
      gtag('config', 'G-R1V6DJN1L3')
    </script>

    <!-- Google AdSense. Declared in /privacy. The tag is loaded on every page,
         but nothing is shown until Google approves the site, and no ad slot is
         placed in the markup yet. `async` keeps it off the critical path. -->
    <meta name="google-adsense-account" content="ca-pub-2789392733984505" />
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2789392733984505"
      crossorigin="anonymous"></script>
  </head>

  <body>
    <!--
    DIRECTION CONTRACT — Cyclorama Dawn
    THESIS: Every page is a lit stage at dawn: depthless cyc black, a cobalt
    horizon, rose light gathering above it; cover art stands on the horizon
    band like actors against a Shinkai sky.
    OWN-WORLD: stagecraft-theater-lighting-cyclorama-dawn — cyc black ground,
    cobalt horizon structure, rose gather, white-day reserved for the active
    state; lighting-plot stencil caps for cue names with tabular numerals;
    content stacked in horizon bands from dark to light; phases named in text
    (night, first light, dawn, hold, day) so colour is never the sole signal.
    STORY: a visitor walks in during the night cue and the answer is already
    standing lit at the horizon.
    FIRST VIEWPORT: black sky, cobalt-to-rose horizon glow, the headline above
    the line, a skyline of covers standing on it.
    FORM: horizon-band index; list position challenger-cyclorama; seed 0a16551e.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, DESIGN.md, and every shipping raster carrying
    its provenance.
    -->
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="shell masthead__inner">
        <a class="wordmark" href="/" aria-label="Manhwa Index home">
          <svg class="wordmark__mark" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M4 4h24v17.5L21.5 28H4Z" fill="none" stroke="currentColor" stroke-width="2.5" />
            <path d="M9 22V10h2.8L16 15.2 20.2 10H23v12h-2.8v-7.4L16 19.6l-4.2-5V22Z" fill="currentColor" />
          </svg>
          manhwa<span>index</span>
        </a>

        <button
          class="menu-btn"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="site-menu"
        >
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <path class="menu-btn__bars" d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <path class="menu-btn__x" d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>

        <div class="masthead__menu" id="site-menu">
          <div class="finder" id="finder">
            <input
              id="finder-input"
              type="search"
              placeholder="Search 3,500 titles…"
              autocomplete="off"
              aria-label="Search titles"
            />
            <ul id="finder-results" hidden></ul>
          </div>

          <nav aria-label="Browse">
            <a href="/" class="nav-home">Home</a>
            {
              nav.map((item) => (
                <a href={item.href} aria-current={here.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="shell colophon__grid">
        <div class="colophon__brand">
          <a class="wordmark" href="/">manhwa<span>index</span></a>
          <p>
            The official-sources index. Look up a manhwa, manga, manhua or anime and
            get the apps and platforms that legally carry it. We host no chapters and
            no episodes — every link goes to the rights holder.
          </p>
          <p class="colophon__count">
            {stats.comics.toLocaleString()} comics · {stats.anime.toLocaleString()} anime · refreshed daily
          </p>
        </div>
        <div>
          <h3>Browse</h3>
          <ul>
            <li><a href="/manhwa">Manhwa</a></li>
            <li><a href="/manga">Manga</a></li>
            <li><a href="/manhua">Manhua</a></li>
            <li><a href="/anime">Anime</a></li>
            <li><a href="/character">Characters</a></li>
            <li><a href="/schedule">Airing this week</a></li>
            <li><a href="/mood">What to read next</a></li>
              <li><a href="/where-to-read">Where to read</a></li>
          </ul>
        </div>
        <div>
          <h3>Genres</h3>
          <ul>
            {footGenres.map((g) => (
              <li><a href={`/genre/${g.slug}`}>{g.name}</a></li>
            ))}
            <li><a href="/genre">All genres</a></li>
          </ul>
        </div>
        <div>
          <h3>About the data</h3>
          <p>
            Title data, scores and cover art come from
            <a href="https://anilist.co" rel="noopener">AniList</a>. Cover art belongs to
            its publishers. Availability changes often — when a link looks wrong, check
            the platform directly. The index rebuilds itself every day at 02:00 UTC, so
            broken links fix themselves.
          </p>
          <p>
            manhwaindex is not affiliated with any publisher or streaming service.
          </p>
          <ul class="colophon__legal">
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/dmca">Copyright / DMCA</a></li>
          </ul>
        </div>
      </div>
      <div class="shell colophon__bar">
        <span>© {year} manhwaindex</span>
        <span>Official sources only. No mirrors, no scans.</span>
      </div>
    </footer>

    <script>
      // Header search. The index is cut into slices named after the first two
      // letters of a word, so typing "to" downloads /search/to.json and
      // nothing else. One slice is a few hundred kilobytes; the whole index
      // would be 28 MB. A slice stays in memory once it has been fetched.
      const input = document.getElementById('finder-input')
      const list = document.getElementById('finder-results')

      // prefix -> a promise for that slice's records.
      const slices = new Map()

      // Records carry only the cover file name. Every cover of the same kind
      // shares this address, so repeating it on every record would be waste.
      const COVER_BASE = 'https://s4.anilist.co/file/anilistcdn/media/'

      // Accents fold away so a loosely typed query still hits.
      const fold = (text) =>
        text
          .toLowerCase()
          .normalize('NFD')
          .replace(/[̀-ͯ]/g, '')

      /** Which slice answers this query: the first two letters of word one. */
      function sliceOf(needle) {
        const word = needle.split(/[^a-z0-9]+/).filter(Boolean)[0] || ''
        return word.length >= 2 ? word.slice(0, 2) : ''
      }

      // A slice is folded once, here, and never again. Folding is
      // normalize() plus toLowerCase() on every row; doing that for 1,500
      // rows on every keypress is what made the box feel slow on a phone.
      // Each row grows two fields: the folded title, and the folded title
      // plus alternate names as one string to test against.
      function prepare(rows) {
        for (const row of rows) {
          const folded = fold(row[0])
          row[5] = folded
          row[6] = row[4] ? folded + " " + row[4] : folded
        }
        return rows
      }

      function loadSlice(prefix) {
        let job = slices.get(prefix)
        if (!job) {
          // A missing slice is an empty one, not an error: nothing in the
          // catalog has a word starting with those two letters.
          job = fetch(`/search/${prefix}.json`)
            .then((res) => (res.ok ? res.json() : []))
            .then(prepare)
            .catch(() => [])
          slices.set(prefix, job)
        }
        return job
      }

      let active = -1

      const escapeHtml = (text) =>
        String(text).replace(
          /[&<>"]/g,
          (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]
        )

      // A record is [ title, url, cover file, year, alternate names ].
      function render(matches) {
        active = -1
        if (!matches.length) {
          list.hidden = true
          list.innerHTML = ''
          return
        }
        list.innerHTML = matches
          .map(([title, url, cover, year]) => {
            const kind = url.split('/')[1]
            const src = cover.includes('://')
              ? cover
              : `${COVER_BASE}${kind === 'anime' ? 'anime' : 'manga'}/cover/small/${cover}`
            return `<li><a href="${escapeHtml(url)}"><img src="${escapeHtml(src)}" alt="" loading="lazy" width="34" height="48" /><span><b>${escapeHtml(title)}</b><em>${escapeHtml(kind)}${year ? ' · ' + year : ''}</em></span></a></li>`
          })
          .join('')
        list.hidden = false
      }

      // Every word of the query must appear; better matches float up:
      // exact title, then title-starts-with, then word-starts-with,
      // then substring. Ties go to the more popular title.
      //
      // `turn` guards against a slow slice landing after the person has typed
      // on. Only the newest search is allowed to draw.
      let turn = 0

      async function search(q) {
        const needle = fold(q)
        const prefix = needle.length >= 2 ? sliceOf(needle) : ''
        if (!prefix) return render([])

        const mine = ++turn

        // The first search for a prefix downloads that slice. On a phone
        // that is a few hundred milliseconds of nothing, which reads as a
        // broken box. Say what is happening instead.
        if (!slices.has(prefix)) {
          list.innerHTML = '<li class="finder-wait">Searching…</li>'
          list.hidden = false
        }

        const rows = await loadSlice(prefix)
        if (mine !== turn) return

        const words = needle.split(/\s+/).filter(Boolean)
        const scored = []
        for (const row of rows) {
          const title = row[5]
          const hay = row[6]
          if (!words.every((w) => hay.includes(w))) continue
          let score = 1
          if (title === needle) score = 4
          else if (title.startsWith(needle)) score = 3
          else if (hay.includes(' ' + needle) || hay.startsWith(needle)) score = 2
          scored.push([score, row])
        }
        // Sorting is stable, so equal scores keep the popularity order the
        // slice was written in. That is why no popularity is stored.
        scored.sort((a, b) => b[0] - a[0])
        render(scored.slice(0, 8).map((x) => x[1]))
      }

      function highlight(delta) {
        const rows = list.querySelectorAll('li')
        if (!rows.length) return
        active = (active + delta + rows.length) % rows.length
        rows.forEach((row, i) => row.classList.toggle('is-active', i === active))
        rows[active].scrollIntoView({ block: 'nearest' })
      }

      input.addEventListener('input', () => search(input.value.trim()))
      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault()
          highlight(1)
        }
        if (e.key === 'ArrowUp') {
          e.preventDefault()
          highlight(-1)
        }
        if (e.key === 'Enter') {
          const rows = list.querySelectorAll('a')
          const pick = rows[active >= 0 ? active : 0]
          if (pick) location.href = pick.href
        }
        if (e.key === 'Escape') render([])
      })
      document.addEventListener('click', (e) => {
        if (!document.getElementById('finder').contains(e.target)) render([])
      })

      // Mobile menu: the button shows and hides the search + nav panel.
      const menuBtn = document.querySelector('.menu-btn')
      menuBtn.addEventListener('click', () => {
        const open = document.body.classList.toggle('menu-open')
        menuBtn.setAttribute('aria-expanded', String(open))
        menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
        if (open) document.getElementById('finder-input').focus()
      })
    </script>
  </body>
</html>
