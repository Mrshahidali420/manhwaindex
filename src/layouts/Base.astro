---
import '../styles/app.css'

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image,
  jsonld,
  noindex = false,
} = Astro.props

const site = 'https://manhwaindex.com'
const canonicalUrl = new URL(canonical, site).href
const nav = [
  { href: '/manhwa', label: 'Manhwa' },
  { href: '/manga', label: 'Manga' },
  { href: '/manhua', label: 'Manhua' },
  { href: '/anime', label: 'Anime' },
  { href: '/genre', label: 'Genres' },
  { href: '/character', label: 'Characters' },
]
const here = Astro.url.pathname
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#050508" />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="manhwaindex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Saira:wght@400;600;700;800&family=Saira+Stencil+One&display=swap"
    />
    <link rel="preconnect" href="https://s4.anilist.co" />

    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>

  <body>
    <!--
    DIRECTION CONTRACT — Cyclorama Dawn
    THESIS: Every page is a lit stage at dawn: depthless cyc black, a cobalt
    horizon, rose light gathering above it; cover art stands on the horizon
    band like actors against a Shinkai sky.
    OWN-WORLD: stagecraft-theater-lighting-cyclorama-dawn — cyc black ground,
    cobalt horizon structure, rose gather, white-day reserved for the active
    state; lighting-plot stencil caps for cue names with tabular numerals;
    content stacked in horizon bands from dark to light; phases named in text
    (night, first light, dawn, hold, day) so colour is never the sole signal.
    STORY: a visitor walks in during the night cue and the answer is already
    standing lit at the horizon.
    FIRST VIEWPORT: black sky, cobalt-to-rose horizon glow, the headline above
    the line, a skyline of covers standing on it.
    FORM: horizon-band index; list position challenger-cyclorama; seed 0a16551e.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, DESIGN.md, and every shipping raster carrying
    its provenance.
    -->
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="shell masthead__inner">
        <a class="wordmark" href="/" aria-label="manhwaindex home">
          <svg class="wordmark__mark" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <circle cx="11" cy="14" r="5" fill="none" stroke="currentColor" stroke-width="2" />
            <line x1="1" y1="14" x2="21" y2="14" stroke="currentColor" stroke-width="2" />
            <line x1="11" y1="3" x2="11" y2="6" stroke="currentColor" stroke-width="2" />
          </svg>
          manhwa<span>index</span>
        </a>

        <div class="finder" id="finder">
          <input
            id="finder-input"
            type="search"
            placeholder="Search 3,500 titles…"
            autocomplete="off"
            aria-label="Search titles"
          />
          <ul id="finder-results" hidden></ul>
        </div>

        <nav aria-label="Browse">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={here.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="shell colophon__grid">
        <div>
          <a class="wordmark" href="/">manhwa<span>index</span></a>
          <p>
            The official-sources index. Look up a manhwa, manga, manhua or anime and get
            the apps and services that legally carry it. We host no chapters and no
            episodes — every link goes to the rights holder.
          </p>
        </div>
        <div>
          <h3>Browse</h3>
          <ul>
            <li><a href="/manhwa">Manhwa</a></li>
            <li><a href="/manga">Manga</a></li>
            <li><a href="/manhua">Manhua</a></li>
            <li><a href="/anime">Anime</a></li>
            <li><a href="/genre">Genres</a></li>
            <li><a href="/character">Characters</a></li>
          </ul>
        </div>
        <div>
          <h3>About</h3>
          <p>
            Title data and cover art come from
            <a href="https://anilist.co" rel="noopener">AniList</a>. Availability changes
            often — when a link looks wrong, check the platform directly. Found a broken
            link? It will fix itself: the index refreshes every day.
          </p>
        </div>
      </div>
      <div class="shell colophon__cue">
        <span class="cue">Cue 00 · Blackout — the index refreshes daily at 02:00 UTC</span>
      </div>
    </footer>

    <script>
      // Header search. The index is one static JSON file, fetched the
      // first time the box is focused, then filtered in memory.
      const input = document.getElementById('finder-input')
      const list = document.getElementById('finder-results')
      let index = null
      let loading = false

      async function loadIndex() {
        if (index || loading) return
        loading = true
        try {
          const res = await fetch('/search-index.json')
          index = await res.json()
        } catch {
          loading = false
        }
      }

      function render(matches) {
        if (!matches.length) {
          list.hidden = true
          list.innerHTML = ''
          return
        }
        list.innerHTML = matches
          .map(
            (m) =>
              `<li><a href="${m.u}"><img src="${m.c}" alt="" loading="lazy" width="34" height="48" /><span><b>${m.t}</b><em>${m.k}${m.y ? ' · ' + m.y : ''}</em></span></a></li>`
          )
          .join('')
        list.hidden = false
      }

      function search(q) {
        if (!index || q.length < 2) return render([])
        const needle = q.toLowerCase()
        const out = []
        for (const m of index) {
          if (m.s.includes(needle)) {
            out.push(m)
            if (out.length === 8) break
          }
        }
        render(out)
      }

      input.addEventListener('focus', loadIndex, { once: false })
      input.addEventListener('input', () => search(input.value.trim()))
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const first = list.querySelector('a')
          if (first) location.href = first.href
        }
        if (e.key === 'Escape') render([])
      })
      document.addEventListener('click', (e) => {
        if (!document.getElementById('finder').contains(e.target)) render([])
      })
    </script>
  </body>
</html>
