---
/**
 * The frame around every /my-admin page.
 *
 * It is deliberately NOT Base.astro. Base carries the Google tag, the AdSense
 * tag and our own counter. The owner reading his own numbers must never appear
 * in his own numbers.
 *
 * It also marks this browser as the owner's, so that every OTHER page on the
 * site stops counting him from now on.
 */
import { RANGES, withRange } from '../lib/admin.js'

const {
  title,
  here = '/my-admin',
  // Which tab to light up. A page that hangs under a tab (Journeys under
  // Pages) passes its tab here and keeps its own address in `here`.
  tab = here,
  range,
  signedIn = false,
  secret = '',
  wrongWord = false,
  refresh = 0,
  note = '',
} = Astro.props

// Each tab answers one kind of question. Journeys and Sections hang under
// Pages; Clicks became Money.
const TABS = [
  { path: '/my-admin', label: 'Now' },
  { path: '/my-admin/week', label: 'This week' },
  { path: '/my-admin/pages', label: 'Pages' },
  { path: '/my-admin/lists', label: 'Lists' },
  { path: '/my-admin/search', label: 'Search' },
  { path: '/my-admin/money', label: 'Money' },
  { path: '/my-admin/health', label: 'Health' },
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {signedIn && refresh > 0 && (
      <meta http-equiv="refresh" content={String(refresh)} />
    )}
    <!--
      is:global matters. Astro keeps a <style> block to the elements written in
      THIS file, and every table below arrives through <slot />. Without this
      word the whole reading room renders as plain unstyled text.
    -->
    <style is:global>
      :root {
        --ink: #0a0a1f;
        --panel: #14142e;
        --edge: #262650;
        --text: #eceaff;
        --dim: #9a97c8;
        --blue: #6f7dff;
        --purple: #a66bff;
        --pink: #ff6fae;
        --good: #4fd1a5;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--ink);
        color: var(--text);
        font: 15px/1.6 system-ui, -apple-system, Segoe UI, sans-serif;
        padding: 20px 16px 64px;
      }
      .wrap { max-width: 1080px; margin: 0 auto; }
      h1 { font-size: 22px; margin: 0 0 4px; }
      h2 { font-size: 15px; margin: 0 0 4px; }
      .sub { color: var(--dim); margin: 4px 0 16px; font-size: 13px; }
      .say { color: var(--dim); font-size: 13px; margin: 0 0 12px; }
      nav.tabs, .ranges {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 14px;
      }
      nav.tabs a, .ranges a {
        padding: 7px 13px;
        border-radius: 999px;
        border: 1px solid var(--edge);
        color: var(--dim);
        text-decoration: none;
        font-size: 13px;
      }
      nav.tabs a[aria-current], .ranges a[aria-current] {
        color: #fff;
        border-color: transparent;
        background: linear-gradient(90deg, var(--purple), var(--pink));
      }
      .ranges a { font-size: 12px; padding: 5px 11px; }
      .cards {
        display: grid;
        gap: 10px;
        grid-template-columns: repeat(2, 1fr);
        margin-bottom: 22px;
      }
      @media (min-width: 620px) {
        .cards { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
      }
      .card, .panel {
        background: var(--panel);
        border: 1px solid var(--edge);
        border-radius: 14px;
      }
      .card { padding: 14px; }
      .card .n {
        font-size: 28px;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.02em;
      }
      .card .t { color: var(--dim); font-size: 12px; margin-top: 4px; line-height: 1.35; }
      .card.live { border-color: var(--pink); }
      .card.live .n { color: var(--pink); }
      .panel { padding: 16px 14px; margin-bottom: 16px; }
      @media (min-width: 620px) { .panel { padding: 18px; } }

      /* A table is allowed to be wider than the phone, but only inside its own
         sideways scroller. The page itself must never scroll sideways. */
      .scroll { overflow-x: auto; margin: 0 -14px; padding: 0 14px; }
      table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
      th, td { text-align: left; padding: 8px 12px 8px 0; vertical-align: top; }
      th {
        color: var(--dim);
        font-weight: 600;
        font-size: 11px;
        text-transform: none;
        white-space: nowrap;
      }
      tr + tr td { border-top: 1px solid var(--edge); }
      td.num, th.num { text-align: right; padding-right: 0; white-space: nowrap; }
      a { color: var(--blue); }

      /* The newest-first lists. A table would squeeze five columns onto a
         phone; this stacks the name over its small facts instead. */
      .feed { display: flex; flex-direction: column; }
      .feed .row {
        display: flex;
        gap: 12px;
        padding: 10px 0;
        align-items: baseline;
      }
      .feed .row + .row { border-top: 1px solid var(--edge); }
      .feed .when {
        color: var(--dim);
        font-size: 12px;
        white-space: nowrap;
        width: 58px;
        flex: none;
      }
      .feed .what { min-width: 0; flex: 1; }
      .feed .what a { text-decoration: none; }
      .feed .what a:hover { text-decoration: underline; }
      .feed .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 5px;
      }
      .feed .meta .tag { margin-left: 0; }
      .bar {
        height: 8px;
        border-radius: 4px;
        background: linear-gradient(90deg, var(--blue), var(--pink));
        min-width: 2px;
      }
      .bar.read { background: var(--blue); }
      .bar.watch { background: var(--purple); }
      .bar.buy { background: var(--pink); }
      .two { display: grid; gap: 18px; grid-template-columns: 1fr; }
      @media (min-width: 760px) { .two { grid-template-columns: 1fr 1fr; } }
      .tag {
        display: inline-block;
        font-size: 11px;
        line-height: 1.7;
        padding: 0 8px;
        border-radius: 999px;
        border: 1px solid var(--edge);
        background: rgba(255, 255, 255, 0.03);
        color: var(--dim);
        margin-left: 6px;
        white-space: nowrap;
      }
      .tag.buy { color: var(--pink); border-color: var(--pink); }
      .tag.go { color: var(--blue); border-color: var(--blue); }
      /* Where the reader came from. The one fact that says how to get more. */
      .tag.src { color: var(--purple); border-color: var(--purple); }
      .chain { font-size: 14px; line-height: 1.9; }
      .chain .hop { color: var(--text); }
      .chain .arrow { color: var(--dim); padding: 0 6px; }
      .chain .did { color: var(--pink); }
      form { max-width: 320px; }
      input {
        width: 100%;
        padding: 12px;
        border-radius: 10px;
        border: 1px solid var(--edge);
        background: var(--ink);
        color: var(--text);
        font-size: 16px;
      }
      button, .btn {
        margin-top: 10px;
        display: inline-block;
        padding: 10px 16px;
        border: 0;
        border-radius: 10px;
        background: linear-gradient(90deg, var(--purple), var(--pink));
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
      }
      button { width: 100%; }
      .bad { color: var(--pink); font-size: 13px; }
      .empty { color: var(--dim); font-size: 13px; }
      footer { color: var(--dim); font-size: 12px; margin-top: 30px; }

      /* A question card: the question as the heading, one number or a short
         ranked list, then one line saying what to do about it. */
      .panel h2 { font-size: 16px; line-height: 1.35; }
      .big { font-size: 34px; font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; margin: 6px 0 2px; }
      .big small { font-size: 14px; font-weight: 400; color: var(--dim); letter-spacing: 0; margin-left: 6px; }
      .delta { font-size: 12.5px; color: var(--dim); }
      .delta.up { color: var(--good); }
      .delta.down { color: var(--pink); }
      .hint {
        margin: 12px 0 0;
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 13.5px;
        line-height: 1.5;
        border-left: 3px solid var(--blue);
        background: rgba(111, 125, 255, 0.08);
      }
      .hint.act { border-color: var(--pink); background: rgba(255, 111, 174, 0.08); }
      .hint.good { border-color: var(--good); background: rgba(79, 209, 165, 0.07); }
      .hint b {
        display: block;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--dim);
        margin-bottom: 2px;
      }
      .rank { list-style: none; margin: 4px 0 0; padding: 0; }
      .rank li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        padding: 8px 0;
      }
      .rank li + li { border-top: 1px solid var(--edge); }
      .rank .name { min-width: 0; overflow-wrap: anywhere; }
      .rank .name a { text-decoration: none; }
      .rank .sub { display: block; color: var(--dim); font-size: 12px; }
      .rank .val { white-space: nowrap; color: var(--text); font-variant-numeric: tabular-nums; }
      .rank .val small { color: var(--dim); font-size: 12px; margin-left: 4px; }
      .feed .what { overflow-wrap: anywhere; }
      td.num, th.num { padding-left: 12px; }
      .more { font-size: 13px; }
      code { overflow-wrap: anywhere; }
    </style>
    <script is:inline>
      // From now on this browser is the owner's, and every page on the site
      // will skip it. It is one flag in this browser only.
      try { localStorage.setItem('mi_off', '1') } catch (e) {}
    </script>
  </head>
  <body>
    <div class="wrap">
      {!secret && (
        <div class="panel">
          <h1>Not set up yet</h1>
          <p class="sub">Run this once on your computer, then reload this page:</p>
          <p><code>npx wrangler secret put ADMIN_SECRET</code></p>
        </div>
      )}

      {secret && !signedIn && (
        <div class="panel">
          <h1>Secret word</h1>
          <p class="sub">Type it once. This browser stays open for 30 days.</p>
          {wrongWord && <p class="bad">That is not the word. Try again.</p>}
          <form method="POST">
            <input type="password" name="word" autocomplete="current-password" autofocus />
            <button type="submit">Open</button>
          </form>
        </div>
      )}

      {signedIn && (
        <>
          <nav class="tabs">
            {TABS.map((item) => (
              <a
                href={range ? withRange(item.path, range) : item.path}
                aria-current={item.path === tab ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>

          {range && (
            <div class="ranges">
              {RANGES.map((r) => (
                <a
                  href={`${here}?range=${r.key}`}
                  aria-current={r.key === range.key ? 'page' : undefined}
                >
                  {r.label}
                </a>
              ))}
            </div>
          )}

          <h1>{title}</h1>
          {note && <p class="sub">{note}</p>}

          <slot />

          <footer>
            Times are UTC. Numbers before today are closed at 00:10 UTC each
            night. Nothing is counted until the visitor moves on the page and
            Cloudflare Turnstile has checked the browser, so robots are kept
            out. Your own visits are not counted.
          </footer>
        </>
      )}
    </div>
  </body>
</html>
