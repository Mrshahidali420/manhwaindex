{
  "name": "manhwaindex",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "dev": "astro dev",
    "build": "node scripts/make-redirects.mjs && node scripts/make-shards.mjs && astro build && node scripts/after-build.mjs",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "ingest:full": "node --max-old-space-size=6000 scripts/ingest-full.mjs",
    "ingest:daily": "node --max-old-space-size=6000 scripts/ingest-daily.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "astro": "^5.6.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
