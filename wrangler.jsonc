{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manhwaindex",
  "compatibility_date": "2026-09-01",
  "routes": [
    {
      "pattern": "manhwaindex.com",
      "custom_domain": true
    },
    {
      "pattern": "www.manhwaindex.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    // Must stay "none". With "404-page" the asset server answers every page
    // navigation itself, and a title page that has no static file gets 404.html
    // without the Worker ever running. The Worker owns the misses.
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Our own visitor counter. A small script on every page posts one row here,
  // and /my-admin reads it back. Bots do not run scripts, so only real people
  // are counted, and the free allowance of 100,000 writes a day is far more
  // than this site can use.
  "d1_databases": [
    {
      "binding": "ANALYTICS",
      "database_name": "manhwaindex-analytics",
      "database_id": "a31cde34-a594-4430-b415-79869e4f4435"
    }
  ],
  // Ten minutes after midnight UTC the Worker adds up the day that just ended
  // and throws away raw rows older than 30 days. See src/lib/rollup.js. Cron
  // runs are free on the Workers free plan: one run is one request.
  "triggers": { "crons": ["10 0 * * *"] },
  "main": "src/worker.js"
}
